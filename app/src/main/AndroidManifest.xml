<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Used only to fetch a GPS fix when the user taps "Use Current Location".
         The app works fully offline otherwise; location is never sent anywhere. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Only needed to load the Google Fonts stylesheet the app links to.
         Everything else (prayer time math, city database, UI) runs offline;
         if this permission is ever removed the app falls back to system fonts. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- The native Qibla compass (QiblaSensorController) needs a
         magnetometer/rotation-vector sensor to show a live needle, but
         gracefully falls back to a static "Qibla is calculated at X°"
         message when neither is present — so both are optional, same as
         the GPS feature below. No runtime permission is needed for either
         sensor type. -->
    <uses-feature
        android:name="android.hardware.sensor.compass"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.sensor.accelerometer"
        android:required="false" />

    <!-- The app has no meaningful use without GPS/network location, but it is
         NOT required to install — manual city / manual coordinates still work
         on devices with no location hardware at all. -->
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <!-- AlarmManager alarms (silent widget refresh ticks + the daily
         recompute tick) don't survive a reboot, so RECEIVE_BOOT_COMPLETED
         is needed to reschedule them. No exact-alarm or notification
         permission is required: every alarm scheduled by this app uses
         the inexact setAndAllowWhileIdle(). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.SalatQibla"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:hardwareAccelerated="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.SalatQibla">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- AlarmManager alarms don't survive a reboot; this reschedules
             the widget-tick and daily-recompute alarms. BOOT_COMPLETED is a
             protected system broadcast, so exported=true here is safe (only
             the system can send it). -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Keeps the widget correct across a timezone change (travel), a
             manual date change, or a manual/NTP wall-clock change — none
             of which the self-rearming DailyRecomputeReceiver alone would
             catch promptly. All three actions are protected system
             broadcasts (on Android's implicit-broadcast exception list),
             so a plain manifest receiver with exported=true is safe and
             sufficient — no runtime registration or foreground service
             needed. See TimeChangeReceiver for details. -->
        <receiver
            android:name=".TimeChangeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Fires once a day to re-derive today's/tomorrow's prayer times
             natively (see AlarmScheduler.recomputeAndSchedule) and keep the
             widget accurate without the app ever being opened. Not
             exported — only ever triggered by our own self-rearmed
             PendingIntent from AlarmManager. -->
        <receiver
            android:name=".DailyRecomputeReceiver"
            android:exported="false" />

        <!-- Silent per-prayer tick that keeps the widget's active row
             accurate at the exact moment each waqt starts, with no user
             interaction required — see WidgetTickReceiver and
             AlarmScheduler.recomputeAndSchedule. Not exported — only ever
             triggered by our own PendingIntent from AlarmManager. -->
        <receiver
            android:name=".WidgetTickReceiver"
            android:exported="false" />

        <!-- Home-screen widget. Times are computed natively by
             AlarmScheduler/Astro.kt (a native port of the same math the
             WebView/JS side uses) and written to SharedPreferences — kept
             fresh by JS syncs while the app is open and by the daily native
             recompute above while it isn't. -->
        <receiver
            android:name=".PrayerWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.safwan.prayertime.WIDGET_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/prayer_widget_info" />
        </receiver>
    </application>

</manifest>
