<?xml version="1.0" encoding="utf-8"?>
<!-- True blur isn't possible for a RemoteViews widget (see widget_background.xml
     for why) — this uses a light scrim instead, which keeps the wallpaper
     visibly showing through while keeping text readable. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:paddingLeft="14dp"
    android:paddingRight="14dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">
        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_title"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:shadowColor="#99000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="3" />
        <ImageButton
            android:id="@+id/widget_refresh"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="#00000000"
            android:src="@drawable/ic_widget_refresh"
            android:contentDescription="@string/widget_refresh_desc"
            android:scaleType="centerInside" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="13dp" android:layout_height="13dp" android:layout_marginEnd="7dp" android:src="@drawable/ic_widget_fajr" />
        <TextView android:id="@+id/row_fajr_name" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="@string/prayer_fajr" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"
            android:shadowColor="#99000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="2" />
        <FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content">
            <TextView android:id="@+id/row_fajr_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#FFFFFF" android:textSize="13sp"
                android:shadowColor="#99000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="2" />
            <TextView android:id="@+id/row_fajr_time_bold" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:visibility="gone"
                android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"
                android:shadowColor="#99000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="2" />
        </FrameLayout>
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="1dp" android:background="#40FFFFFF" android:text="" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="13dp" android:layout_height="13dp" android:layout_marginEnd="7dp" android:src="@drawable/ic_widget_dhuhr" />
        <TextView android:id="@+id/row_dhuhr_name" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="@string/prayer_dhuhr" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"
            android:shadowColor="#99000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="2" />
        <FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content">
            <TextView android:id="@+id/row_dhuhr_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#FFFFFF" android:textSize="13sp"
                android:shadowColor="#99000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="2" />
            <TextView android:id="@+id/row_dhuhr_time_bold" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:visibility="gone"
                android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"
                android:shadowColor="#99000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="2" />
        </FrameLayout>
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="1dp" android:background="#40FFFFFF" android:text="" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="13dp" android:layout_height="13dp" android:layout_marginEnd="7dp" android:src="@drawable/ic_widget_asr" />
        <TextView android:id="@+id/row_asr_name" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="@string/prayer_asr" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"
            android:shadowColor="#99000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="2" />
        <FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content">
            <TextView android:id="@+id/row_asr_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#FFFFFF" android:textSize="13sp"
                android:shadowColor="#99000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="2" />
            <TextView android:id="@+id/row_asr_time_bold" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:visibility="gone"
                android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"
                android:shadowColor="#99000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="2" />
        </FrameLayout>
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="1dp" android:background="#40FFFFFF" android:text="" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="13dp" android:layout_height="13dp" android:layout_marginEnd="7dp" android:src="@drawable/ic_widget_maghrib" />
        <TextView android:id="@+id/row_maghrib_name" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="@string/prayer_maghrib" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"
            android:shadowColor="#99000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="2" />
        <FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content">
            <TextView android:id="@+id/row_maghrib_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#FFFFFF" android:textSize="13sp"
                android:shadowColor="#99000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="2" />
            <TextView android:id="@+id/row_maghrib_time_bold" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:visibility="gone"
                android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"
                android:shadowColor="#99000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="2" />
        </FrameLayout>
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="1dp" android:background="#40FFFFFF" android:text="" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="13dp" android:layout_height="13dp" android:layout_marginEnd="7dp" android:src="@drawable/ic_widget_isha" />
        <TextView android:id="@+id/row_isha_name" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="@string/prayer_isha" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"
            android:shadowColor="#99000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="2" />
        <FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content">
            <TextView android:id="@+id/row_isha_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#FFFFFF" android:textSize="13sp"
                android:shadowColor="#99000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="2" />
            <TextView android:id="@+id/row_isha_time_bold" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:visibility="gone"
                android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"
                android:shadowColor="#99000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="2" />
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
