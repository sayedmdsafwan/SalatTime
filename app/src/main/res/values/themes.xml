<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- The web app renders its own header/status area, so the native
         activity uses a NoActionBar theme and just hosts a full-screen
         WebView. -->
    <style name="Theme.SalatQibla" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryDark">@color/brand_dark</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor" tools:targetApi="21">@color/brand_dark</item>
    </style>
</resources>
