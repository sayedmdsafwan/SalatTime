<?xml version="1.0" encoding="utf-8"?>
<!-- True background blur isn't possible for a third-party AppWidget (a
     RemoteViews layout has no access to the pixels behind it — only the
     system launcher can blur the live wallpaper). This uses a light scrim
     instead, which keeps the wallpaper visibly showing through while
     keeping text readable. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="20dp" />
    <solid android:color="#3A000000" />
</shape>
